# Copy this file to .env and fill in your own key. Never commit .env.
# Chatbot: Gemini is used if GEMINI_API_KEY is set, otherwise Groq.
GEMINI_API_KEY=replace-with-your-own-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
# GROQ_API_KEY=
CONFIDENCE_THRESHOLD=0.5
PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
COOKIE_SECURE=false
# Optional in local development; set exact site origins when deploying.
CORS_ORIGINS=
